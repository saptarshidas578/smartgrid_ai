# ==============================================================================
# SMART GRID AI AUTONOMOUS CONTROLLER: CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and configure with your actual credentials.
# ==============================================================================

# MQTT Broker (HiveMQ Cloud TLS)
MQTT_BROKER=your_hivemq_cluster_url.hivemq.cloud
MQTT_PORT=8883
MQTT_USER=your_mqtt_username
MQTT_PASSWORD=your_mqtt_password
MQTT_TOPIC_LIVE=smartgrid/live
MQTT_TOPIC_CONTROL=smartgrid/control

# Telegram Push Notifications
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
TELEGRAM_SEND_STATUS_CARDS=true

# Web SCADA Dashboard
SCADA_HOST=0.0.0.0
SCADA_PORT=8000

# Control Loop Timing & Safety Constants
UPDATE_INTERVAL_SEC=2.0
STARTUP_OBSERVE_SEC=30.0
RELAY_SETTLING_SEC=15.0
RESTORATION_SETTLING_SEC=15.0
MAX_RESTORE_UTIL_PCT=84.0
SHED_UTIL_PCT=85.0
HIGH_LOAD_UTIL_PCT=80.0
MEDIUM_LOAD_UTIL_PCT=70.0
